function getAutoCustomVar(xmlConfigObj, target) {
  console.log("getAutoCustomVar target: ", target);
  let base = xmlConfigObj.BATCH_MODE.DESIGNS_DB[0].VARIABLES[0].VARIABLE;
  for (let i = 0; i < base.length; i++) {
    // console.log("element.$.name: ", base[i].$.name);
    if (target === base[i].$.name.toString()) {
      console.log("getAutoCustomVar finded: ", target);
      return {
        index: i,
        name: base[i].$.name,
        lowerbound: base[i].$.lowerbound,
        value: base[i].$.value,
        upperbound: base[i].$.upperbound,
      };
    }
  }
